#!/usr/bin/env bash
set -euo pipefail

root="${THEIA_REPO_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
source_file="$root/source.nix"
fake='sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA='

version="$(nix eval --raw --file "$source_file" version)"
src_hash="$(nix eval --raw --file "$source_file" srcHash)"
yarn_hash="$(nix eval --raw --file "$source_file" yarnHash)"

[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "invalid stable version in source.nix: $version" >&2
  exit 1
}

for value in "$src_hash" "$yarn_hash"; do
  [[ "$value" =~ ^sha256-[A-Za-z0-9+/]{43}=$ ]] || {
    echo "invalid SRI SHA-256 in source.nix: $value" >&2
    exit 1
  }
  [[ "$value" != "$fake" ]] || {
    echo "source.nix still contains a bootstrap fake hash; run ./scripts/update-sources" >&2
    exit 1
  }
done
